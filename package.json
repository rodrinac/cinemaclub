{
  "name": "cinemaclub",
  "version": "2.6.4",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "api": "node --env-file=.env server/movies-api.mjs",
    "validate:eas:movies-api-url": "node scripts/verify-eas-public-movies-api-url.mjs",
    "eas-build-pre-install": "npm run validate:eas:movies-api-url",
    "lint": "eslint .",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "test": "jest",
    "test:ci": "npm run test:ci:stub",
    "test:ci:stub": "jest --ci && npm run test:e2e:stub",
    "test:e2e:live": "playwright test --config=playwright.config.live.ts",
    "test:e2e:live:ci": "playwright test --config=playwright.config.live.ts",
    "test:e2e:stub": "playwright test --config=playwright.config.stub.ts",
    "build:web": "expo export --platform web",
    "build:web:production": "eas env:exec production \"npx expo export --platform web --clear\" --non-interactive",
    "prebuild:check": "expo prebuild --clean --no-install"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7",
    "@react-navigation/stack": "^7",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "expo": "^58.0.19",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "install": "^0.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-paper": "^5.13.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "postcss": "^8.5.28",
    "uuid": "^11.1.1",
    "compression": "^1.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.0.1",
    "jest": "~29.7.0",
    "prettier": "^3.5.1",
    "prettier-plugin-organize-imports": "^4.1.0",
    "serve": "^14.2.6",
    "ts-jest": "^29.4.12",
    "typescript": "~5.8.3"
  }
}
