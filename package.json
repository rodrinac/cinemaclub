{
  "name": "cinemaclub",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "api": "node --env-file=.env server/movies-api.mjs",
    "validate:eas:movies-api-url": "node scripts/verify-eas-public-movies-api-url.mjs",
    "eas-build-pre-install": "npm run validate:eas:movies-api-url",
    "lint": "eslint .",
    "test": "jest",
    "test:ci": "npm run test:ci:stub",
    "test:ci:stub": "jest --ci && npm run test:e2e:stub",
    "test:e2e:live": "playwright test --config=playwright.config.live.ts",
    "test:e2e:live:ci": "playwright test --config=playwright.config.live.ts",
    "test:e2e:stub": "playwright test --config=playwright.config.stub.ts",
    "build:web": "expo export --platform web",
    "build:web:production": "eas env:exec production \"npx expo export --platform web --clear\" --non-interactive",
    "prebuild:check": "expo prebuild --clean --no-install"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.1.0",
    "@expo-google-fonts/roboto-condensed": "^0.1.0",
    "@expo-google-fonts/ubuntu": "^0.1.0",
    "@expo/metro-runtime": "~5.0.5",
    "@react-navigation/native": "^7",
    "@react-navigation/stack": "^7",
    "axios": "^1.20.0",
    "expo": "^53.0.27",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-font": "~13.3.2",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-store-review": "~8.1.5",
    "expo-web-browser": "~14.2.0",
    "install": "^0.13.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-paper": "^5.13.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-vector-icons": "^8.1.0",
    "react-native-web": "^0.20.0"
  },
  "overrides": {
    "react-native": "0.79.6",
    "@react-native/community-cli-plugin": "0.79.6",
    "@react-native/debugger-frontend": "0.79.6",
    "@react-native/dev-middleware": "0.79.6",
    "@react-native/virtualized-lists": "0.79.6",
    "metro": "0.82.5",
    "metro-babel-transformer": "0.82.5",
    "metro-cache": "0.82.5",
    "metro-cache-key": "0.82.5",
    "metro-config": "0.82.5",
    "metro-core": "0.82.5",
    "metro-file-map": "0.82.5",
    "metro-minify-terser": "0.82.5",
    "metro-resolver": "0.82.5",
    "metro-runtime": "0.82.5",
    "metro-source-map": "0.82.5",
    "metro-symbolicate": "0.82.5",
    "metro-transform-plugins": "0.82.5",
    "metro-transform-worker": "0.82.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "babel-preset-expo": "~13.0.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^30.5.1",
    "prettier": "^3.5.1",
    "prettier-plugin-organize-imports": "^4.1.0",
    "serve": "^14.2.6",
    "ts-jest": "^29.4.12",
    "typescript": "~5.8.3"
  }
}
