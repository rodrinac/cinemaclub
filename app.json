{
  "expo": {
    "name": "Cinema Club",
    "slug": "cinemaclub",
    "scheme": "cinemaclub",
    "userInterfaceStyle": "automatic",
    "githubUrl": "https://github.com/rodrinac/cinemaclub",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "android": {
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.nu.production",
      "package": "com.anonymous.cinemaclub"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.cinemaclub",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E3E8F5",
          "image": "./assets/splash.png",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#1c2646"
          },
          "imageWidth": 216
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "d5f1cf03-fba3-4d98-8c6f-ed5771ff0ea4"
      }
    },
    "owner": "josersinacio"
  }
}
