# Server-only secret. Never add this value to EXPO_PUBLIC_* variables.
TMDB_API_TOKEN=your_tmdb_bearer_token

# Public URL of the local API consumed by the Expo app during local development only.
# Remote EAS preview/production builds must read EXPO_PUBLIC_MOVIES_API_URL from EAS environments instead.
EXPO_PUBLIC_MOVIES_API_URL=http://localhost:3001/api
